#!/bin/sh
# OTA poller: manifest check -> RAUC install -> tryboot reboot.
set -eu

log() { echo "openmower-updater: $*"; }

[ -f /etc/openmower-updater.conf ] && . /etc/openmower-updater.conf
[ -f /data/openmower-updater.conf ] && . /data/openmower-updater.conf

if [ -z "${UPDATE_URL:-}" ]; then
    log "no UPDATE_URL configured, skipping"
    exit 0
fi

. /etc/os-release   # provides VERSION_ID

STATE_DIR=/data/update
mkdir -p "$STATE_DIR"
MANIFEST="$STATE_DIR/manifest.json"
BUNDLE="$STATE_DIR/bundle.raucb"

curl -fsSL --max-time 30 "$UPDATE_URL/manifest.json" -o "$MANIFEST"

# manifest.json is generated by server/publish.sh: one key per line.
get_field() {
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\{0,1\}\([^",}]*\)"\{0,1\}.*/\1/p' \
        "$MANIFEST" | head -n1
}

REMOTE_VERSION="$(get_field version)"
BUNDLE_URL="$(get_field url)"
BUNDLE_SHA="$(get_field sha256)"

if [ -z "$REMOTE_VERSION" ] || [ -z "$BUNDLE_URL" ]; then
    log "invalid manifest"
    exit 1
fi

if [ "${ALLOW_DOWNGRADE:-0}" != "1" ] && [ "$REMOTE_VERSION" -le "$VERSION_ID" ]; then
    log "up to date ($VERSION_ID)"
    exit 0
fi
if [ "$REMOTE_VERSION" = "$VERSION_ID" ]; then
    log "already running $VERSION_ID"
    exit 0
fi

# A previous attempt at this version that never became the running system
# (failed install or rolled-back boot) blocks retries until the server
# publishes something new. Clear /data/update/attempted to force a retry.
if [ "$(cat "$STATE_DIR/attempted" 2>/dev/null)" = "$REMOTE_VERSION" ]; then
    log "version $REMOTE_VERSION already attempted and not running, holding off"
    exit 0
fi

log "updating $VERSION_ID -> $REMOTE_VERSION"

# Resolve relative bundle URLs against the server base.
case "$BUNDLE_URL" in
    http://*|https://*) ;;
    *) BUNDLE_URL="$UPDATE_URL/$BUNDLE_URL" ;;
esac

# Stall-detection instead of a flat deadline: bundles now carry the full
# vendored ROS/Ubuntu payload (multi-GB) so a fixed wall-clock cap would
# time out legitimate slow-but-progressing downloads. Abort only if
# throughput drops below 1KB/s for a full minute.
curl -fsSL --speed-limit 1024 --speed-time 60 "$BUNDLE_URL" -o "$BUNDLE"

if [ -n "$BUNDLE_SHA" ]; then
    echo "$BUNDLE_SHA  $BUNDLE" | sha256sum -c - >/dev/null || {
        log "bundle checksum mismatch"
        rm -f "$BUNDLE"
        exit 1
    }
fi

printf '%s\n' "$REMOTE_VERSION" > "$STATE_DIR/attempted"

if ! rauc install "$BUNDLE"; then
    log "rauc install failed"
    rm -f "$BUNDLE"
    exit 1
fi
rm -f "$BUNDLE" "$MANIFEST"

log "install ok, rebooting into new slot (tryboot)"
sync
mkdir -p /run/systemd
printf '0 tryboot' > /run/systemd/reboot-param
systemctl reboot
